# Copy this file to .env.local and set the values the deployment needs.
# NODE_ENV is set by the framework rather than by a deployment, so it is not listed here.

# Required at request time. Read server-side only: never logged, never exposed to the browser.
# Unset: a generation request answers 503 PROVIDER_UNAVAILABLE with an actionable message; the server still starts.
OPENAI_API_KEY=your-openai-api-key-here

# Optional. Model used for the Responses API call. Unset: defaults to gpt-6-luna.
OPENAI_MODEL=gpt-6-luna

# Optional. openai streams from the OpenAI Responses API; stub returns deterministic text with no network call.
# Unset: defaults to openai. stub is refused when NODE_ENV=production, so the test seam cannot ship as the product.
PROMPT_PROVIDER=openai

# Optional. Port used by `next start` and by the Playwright base URL. Unset: defaults to 3000.
PORT=3000
