# Dependencies
node_modules/

# Next.js build output
.next/
out/
# next-env.d.ts is deliberately not ignored: it is a generated artefact this
# repository commits, so a fresh checkout type-checks before its first build.

# Test and coverage output
coverage/
playwright-report/
test-results/
blob-report/

# Environment files: a real .env holds the provider credential and is never
# committed, while .env.example carries placeholders and stays tracked.
.env*
!.env.example

# Logs
*.log
npm-debug.log*

# TypeScript build info
*.tsbuildinfo

# OS and editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
